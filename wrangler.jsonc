{
  // Cloudflare Worker with static assets. Cloudflare retired new Pages projects,
  // so this is the Workers equivalent: the 26 static pages are served from
  // dist/client, and src/index.js handles the form POSTs.
  //
  // Build:   python3 build.py      (that is the whole build)
  // Deploy:  npx wrangler deploy
  //
  // dist/ is not committed - Cloudflare rebuilds it from source on every push.

  "name": "racfit-site",
  "compatibility_date": "2026-09-10",

  // The form handler, deployed as written. It used to be compiled from a
  // functions/ directory by `wrangler pages functions build`; that step was one
  // more thing to fail in CI and bought nothing for a single dynamic route, so
  // the file now does its own routing and ships as source.
  "main": "./src/index.js",

  "assets": {
    "directory": "./dist/client/",

    // Serve /404.html for any path that matches no asset. Without this the
    // default falls back to index.html, which would return 200 for every typo
    // and let search engines index unlimited soft-404s.
    "not_found_handling": "404-page",

    "binding": "ASSETS",

    // REQUIRED, and the reason is not obvious. With the default
    // (run_worker_first: false) the asset layer handles a request that matches
    // no asset by applying not_found_handling - it does NOT fall through to the
    // Worker. A POST to /api/contact would therefore be answered with the 404
    // page and every form would fail silently.
    //
    // Scoping it to /api/* sends only the form endpoints to the Worker and
    // leaves all 166 static files served straight from the edge, which
    // run_worker_first: true would not do.
    "run_worker_first": ["/api/*"]
  },

  "observability": {
    // Keeps the Worker's console.error output visible in the dashboard, which is
    // where a Resend rejection or a Turnstile failure shows up. The handler
    // logs status codes only - never a key, never a visitor's details.
    "enabled": true
  }
}
