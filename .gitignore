# Build output. Cloudflare runs the build on every push and deploys what it
# produces, so committing either of these would just be a second copy that can
# go stale. dist/client is the static site; dist/worker is the compiled form
# handler.
dist/
node_modules/

# Packaged copies - the repo is the source of truth now.
*.zip
site-mirror.tar.gz

# Local preview copies made by double-clicking a zip in Finder.
racfit-site-full*/

# Wrangler's local build and dev cache. Machine-specific, regenerated on every
# `wrangler dev`/`deploy`, and it embeds a bundled copy of the handler that goes
# stale the moment src/index.js changes.
.wrangler/

# QA scaffolding
_qa_out.txt
_qafonts/
_idcheck/

# macOS / Python
.DS_Store
__pycache__/
*.pyc
